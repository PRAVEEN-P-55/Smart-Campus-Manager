generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  headFacultyId String?
  users         User[]
  courses       Course[]
  announcements Announcement[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id              String   @id @default(cuid())
  roleId          String
  departmentId    String?
  name            String
  email           String   @unique
  passwordHash    String?
  authProvider    String   @default("email")
  phone           String?
  avatarUrl       String?
  emailVerified   Boolean  @default(true)
  status          String   @default("active")
  lastLoginAt     DateTime?
  role            Role     @relation(fields: [roleId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  studentProfile  StudentProfile?
  facultyProfile  FacultyProfile?
  courses         Course[]
  attendanceSessions AttendanceSession[] @relation("FacultySessions")
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  markedRecords       AttendanceRecord[] @relation("MarkedAttendance")
  assignments      Assignment[]
  submissions      AssignmentSubmission[] @relation("StudentSubmissions")
  reviewedSubmissions AssignmentSubmission[] @relation("ReviewedSubmissions")
  events           CampusEvent[]
  eventRegistrations EventRegistration[]
  placements       Placement[]
  placementApplications PlacementApplication[]
  clubs            Club[]
  clubMemberships  ClubMembership[]
  announcements    Announcement[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentProfile {
  id          String @id @default(cuid())
  userId      String @unique
  rollNumber  String @unique
  semester    Int
  skills      String @default("")
  githubUrl   String?
  linkedinUrl String?
  resumeUrl   String?
  bio         String?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacultyProfile {
  id             String @id @default(cuid())
  userId         String @unique
  employeeId     String @unique
  designation    String?
  specialization String?
  officeLocation String?
  bio            String?
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String @id @default(cuid())
  departmentId String
  facultyId  String?
  name        String
  code        String @unique
  semester    Int
  credits     Int?
  department  Department @relation(fields: [departmentId], references: [id])
  faculty     User? @relation(fields: [facultyId], references: [id])
  attendanceSessions AttendanceSession[]
  assignments Assignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttendanceSession {
  id          String @id @default(cuid())
  courseId    String
  facultyId   String
  title       String
  sessionDate DateTime
  status      String @default("draft")
  course      Course @relation(fields: [courseId], references: [id])
  faculty     User @relation("FacultySessions", fields: [facultyId], references: [id])
  records     AttendanceRecord[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttendanceRecord {
  id                  String @id @default(cuid())
  attendanceSessionId String
  studentId           String
  status              String
  markedBy            String
  markedAt            DateTime @default(now())
  remarks             String?
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             User @relation("StudentAttendance", fields: [studentId], references: [id])
  marker              User @relation("MarkedAttendance", fields: [markedBy], references: [id])

  @@unique([attendanceSessionId, studentId])
}

model Assignment {
  id            String @id @default(cuid())
  courseId      String
  facultyId     String
  title         String
  description   String
  deadline      DateTime
  attachmentUrl String?
  rubric        String?
  maxMarks      Int?
  status        String @default("draft")
  course        Course @relation(fields: [courseId], references: [id])
  faculty       User @relation(fields: [facultyId], references: [id])
  submissions   AssignmentSubmission[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AssignmentSubmission {
  id             String @id @default(cuid())
  assignmentId   String
  studentId      String
  submissionType String
  fileUrl        String?
  githubUrl      String?
  submittedAt    DateTime @default(now())
  late           Boolean @default(false)
  marks          Int?
  feedback       String?
  reviewedBy     String?
  reviewedAt     DateTime?
  status         String @default("submitted")
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User @relation("StudentSubmissions", fields: [studentId], references: [id])
  reviewer       User? @relation("ReviewedSubmissions", fields: [reviewedBy], references: [id])

  @@unique([assignmentId, studentId])
}

model CampusEvent {
  id                   String @id @default(cuid())
  createdBy            String
  title                String
  description          String
  venue                String
  eventStart           DateTime
  eventEnd             DateTime?
  registrationDeadline DateTime
  totalSeats           Int
  availableSeats       Int
  speakers             String @default("")
  status               String @default("draft")
  creator              User @relation(fields: [createdBy], references: [id])
  registrations        EventRegistration[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model EventRegistration {
  id           String @id @default(cuid())
  eventId      String
  studentId    String
  ticketCode   String @unique
  status       String @default("registered")
  registeredAt DateTime @default(now())
  cancelledAt  DateTime?
  event        CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      User @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
}

model Placement {
  id          String @id @default(cuid())
  createdBy   String
  companyName String
  jobRole     String
  eligibility String
  ctc         String?
  location    String?
  deadline    DateTime
  description String?
  applyUrl    String?
  status      String @default("open")
  creator     User @relation(fields: [createdBy], references: [id])
  applications PlacementApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlacementApplication {
  id          String @id @default(cuid())
  placementId String
  studentId   String
  resumeUrl   String?
  status      String @default("applied")
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  student     User @relation(fields: [studentId], references: [id])

  @@unique([placementId, studentId])
}

model Club {
  id            String @id @default(cuid())
  coordinatorId String?
  name          String @unique
  description   String?
  category      String?
  logoUrl       String?
  status        String @default("active")
  coordinator   User? @relation(fields: [coordinatorId], references: [id])
  memberships   ClubMembership[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClubMembership {
  id             String @id @default(cuid())
  clubId         String
  studentId      String
  membershipRole String @default("member")
  status         String @default("pending")
  joinedAt       DateTime?
  club           Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student        User @relation(fields: [studentId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([clubId, studentId])
}

model Announcement {
  id           String @id @default(cuid())
  createdBy    String
  title        String
  body         String
  audience     String
  departmentId String?
  priority     String @default("normal")
  attachmentUrl String?
  publishedAt DateTime?
  expiresAt    DateTime?
  status       String @default("draft")
  creator      User @relation(fields: [createdBy], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id                String @id @default(cuid())
  userId            String
  title             String
  message           String
  type              String
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean @default(false)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model ActivityLog {
  id         String @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ipAddress  String?
  actor      User? @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
}
